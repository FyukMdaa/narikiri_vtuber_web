# ──────────────────────────────────────────────────────────────
# .env - フォト機能など、フロントエンドに注入される環境変数
#
# このファイルは scripts/inject-env.mjs によって読み込まれ、
# web/js/env.js として生成・上書きされます。
# フロントエンドのコードからは直接 .env を参照せず、
# 生成された env.js を import して利用します。
#
# 書式: KEY=VALUE (空白・引用符は自動でトリムされます)
# ──────────────────────────────────────────────────────────────

# フォトフレームに描画される文字列（アプリ名・キャッチコピーなど）
PHOTO_FRAME_TEXT=大濠文化祭2026

# フォトフレームの右下に表示される署名（任意）
PHOTO_FRAME_SUBTEXT=コンピューター同好会

# フォトフレームの色（CSS カラー文字列）
PHOTO_FRAME_COLOR=#3b82f6

# フォト保存時のファイル名プリフィックス
PHOTO_FILE_PREFIX=vtuber-photo
